{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOM Wallet V3",
  "version": "0.3.3",
  "identifier": "org.domprotocol.wallet.v3",
  "build": {
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [{ "label": "main", "title": "DOM Wallet V3", "width": 1100, "height": 760 }]
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": ["../frontend/assets/dom-coin.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgNzQxOTdBOTVDQTMwOUNGMApSV1R3bkRES2xYb1pkRzNvYlZSaUxQZlZSSHIxN0UwRmoyR044SVoyckJraXBSWnZJSVc2UExKMwo=",
      "endpoints": [
        "https://github.com/sorenplanck/dom-wallet-v3/releases/latest/download/latest.json"
      ]
    }
  }
}
